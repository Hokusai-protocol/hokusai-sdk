{
  "name": "@hokusai/adapter-claude-code",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hokusai-route": "./plugin/bin/hokusai-route",
    "hokusai-report": "./plugin/bin/hokusai-report"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin"
  ],
  "dependencies": {
    "@hokusai/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "bundle:plugin": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist-bundle/index.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
