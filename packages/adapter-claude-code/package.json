{
  "name": "@hokusai/adapter-claude-code",
  "version": "0.1.3",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hokusai-protocol/hokusai-sdk",
    "directory": "packages/adapter-claude-code"
  },
  "bin": {
    "hokusai-route": "./plugin/bin/hokusai-route",
    "hokusai-report": "./plugin/bin/hokusai-report",
    "hokusai-privacy": "./plugin/bin/hokusai-privacy",
    "hokusai-doctor": "./plugin/bin/hokusai-doctor",
    "hokusai-outcome-hook": "./plugin/bin/hokusai-outcome-hook"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hokusai/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "bundle:plugin": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=plugin/dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
