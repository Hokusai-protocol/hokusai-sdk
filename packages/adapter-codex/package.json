{
  "name": "@hokusai/adapter-codex",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hokusai-protocol/hokusai-sdk",
    "directory": "packages/adapter-codex"
  },
  "bin": {
    "hokusai-codex-mcp": "./plugin/bin/hokusai-codex-mcp",
    "hokusai-codex-outcome-hook": "./plugin/bin/hokusai-codex-outcome-hook"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hokusai/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "bundle:plugin": "esbuild src/mcp-server.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist-bundle/index.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --root ../.. packages/adapter-codex/src",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
