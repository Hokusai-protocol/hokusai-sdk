#!/usr/bin/env node

const candidates = ['../../dist-bundle/index.js', '../dist/index.js'];

async function main() {
  let lastError;

  for (const candidate of candidates) {
    try {
      const imported = await import(new URL(candidate, import.meta.url).href);
      if (typeof imported.runCodexOutcomePromptHookCli === 'function') {
        const result = await imported.runCodexOutcomePromptHookCli(
          process.argv.slice(2),
          process.env,
        );
        if (result.stdout) {
          process.stdout.write(result.stdout);
        }
        if (result.stderr) {
          process.stderr.write(result.stderr);
        }
        process.exitCode = result.exitCode;
        return;
      }
    } catch (error) {
      lastError = error;
    }
  }

  process.stderr.write(
    `hokusai-codex-outcome-hook failed to start: ${lastError instanceof Error ? (lastError.stack ?? lastError.message) : String(lastError)}\n`,
  );
  process.exitCode = 0;
}

void main();
