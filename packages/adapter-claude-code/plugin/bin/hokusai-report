#!/usr/bin/env node

import { runReportCli } from '../../dist/index.js';

const result = await runReportCli(process.argv.slice(2), process.env);

if (result.stdout) {
  process.stdout.write(result.stdout);
}

if (result.stderr) {
  process.stderr.write(result.stderr);
}

process.exit(result.exitCode);
